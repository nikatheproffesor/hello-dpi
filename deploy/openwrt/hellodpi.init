#!/bin/sh /etc/rc.common
# Hello DPI procd init script for OpenWrt
# Placed at /etc/init.d/hellodpi

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/hellodpi
CONF=/etc/config/hellodpi

start_service() {
	local enabled=1
	local addr="0.0.0.0:18080"
	local mode="adaptive"
	local delay=2
	local doh=1
	local doh_server="https://cloudflare-dns.com/dns-query"
	local extra_args=""

	if [ -f "$CONF" ]; then
		config_load hellodpi
		config_get_bool enabled config enabled 1
		config_get addr config addr "0.0.0.0:18080"
		config_get mode config mode "adaptive"
		config_get delay config delay 2
		config_get_bool doh config doh 1
		config_get doh_server config doh_server "https://cloudflare-dns.com/dns-query"
		config_get extra_args config extra_args ""
	fi

	[ "$enabled" -eq 1 ] || {
		echo "Hello DPI is disabled in $CONF"
		return 0
	}

	[ -x "$PROG" ] || {
		echo "Executable $PROG not found. Please install hellodpi to /usr/bin/hellodpi"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" \
		-addr "$addr" \
		-mode "$mode" \
		-delay "$delay" \
		-doh="$doh" \
		-doh-server "$doh_server" \
		$extra_args
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param user root
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "hellodpi"
}

[Unit]
Description=Hello DPI - Cross-Platform Zero-Overhead DPI Bypass Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/hellodpi -addr 0.0.0.0:18080 -mode adaptive -doh=true
Restart=always
RestartSec=3s
LimitNOFILE=65535

# Process Hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
